# ──────────────────────────────────────────────
# HelloJi CRM — Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────

# Environment mode — set to "production" in deployment
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/helloji

# JWT signing secret — use a long random string in production
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=8h

# Seed admin credentials (used on first run only)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@helloji.in
SEED_ADMIN_PHONE=+919356444000
SEED_ADMIN_PASSWORD=changeme123

# CORS — comma-separated origins allowed to call this API
CORS_ORIGIN=http://localhost:8080

# Server port
PORT=5000

# Application URLs (update for production deployment)
FRONTEND_URL=http://localhost:8080
PUBLIC_BASE_URL=http://localhost:5000

# SMTP Email Configuration (Nodemailer)
# Leave empty to disable — returns 503 SMTP_NOT_CONFIGURED
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Helloji Booking Desk <noreply@helloji.in>

# Pinbot.ai WhatsApp Business API Configuration
# Leave empty to disable — returns 503 WHATSAPP_NOT_CONFIGURED
PINBOT_API_KEY=
PINBOT_WA_NUMBER=
PINBOT_API_URL=https://partners.pinbot.ai/v2/messages
